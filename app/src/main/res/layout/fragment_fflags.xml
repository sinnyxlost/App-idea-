<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="FFlag Editor"
            android:textColor="@color/black_text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="MasterStrap-compatible. Writes to the same ClientAppSettings.json Roblox reads on launch."
            android:textColor="@color/black_soft"
            android:textSize="12sp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:id="@+id/flagList"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnApplyFlags"
            android:text="Apply Selected FFlags"
            android:textColor="@color/black_text"
            android:backgroundTint="@color/pink_accent"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnRemoveFlags"
            android:text="Remove All (restore original)"
            android:textColor="@color/black_text"
            android:backgroundTint="@color/tab_active"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/fflagLog"
            android:textColor="@color/black_text"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:paddingTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
